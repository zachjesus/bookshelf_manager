DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://shelves.example.org
DJANGO_SECURE_COOKIES=0
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_AGE=43200
DJANGO_DB_PATH=/var/lib/bookshelf_manager/auth.sqlite3
DJANGO_ADMIN_URL=admin
DJANGO_TIME_ZONE=America/New_York

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gutenberg
PGUSER=gutenberg
# PGPASSWORD=  # optional; libpq also reads ~/.pgpass
# PGSSLMODE=require

BSM_REAUTH_SECONDS=900
BSM_PAGE_SIZE=50
BSM_RATE_BROWSE=120/m
BSM_RATE_WRITE=60/m
BSM_RATE_LOGIN=10/m
BSM_RATE_API=60/m
BSM_REVIEWERS=reviewer@example.org
BSM_API_KEY=change-me
BSM_API_HOSTS=127.0.0.1,localhost
BSM_SITE_URL=http://127.0.0.1:8000

EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=bookshelf@localhost
